generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// CORE ENTITIES
// -----------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exams            Exam[]
  studyTasks       StudyTask[]
  studySessions    StudySession[]
  practiceAttempts PracticeAttempt[]
  notes            Note[]
  calendarEvents   CalendarEvent[]
  aiConversations  AIConversation[]
  topicWeightages  TopicWeightage[]
  subjectWeightages SubjectWeightage[]
}

model Exam {
  id                     String     @id @default(cuid())
  userId                 String?
  name                   String
  organization           String?
  description            String?
  notificationDate       DateTime?
  applicationStartDate   DateTime?
  applicationEndDate     DateTime?
  prelimsDate            DateTime?
  mainsDate              DateTime?
  examDate               DateTime?
  officialWebsite        String?
  totalMarks             Int?
  minimumQualifyingMarks String?
  weightageDistribution  Json?
  examPatternData        Json?
  status                 ExamStatus @default(UPCOMING)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  isDevelopment          Boolean    @default(false)

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  examStages        ExamStage[]
  subjects          Subject[]
  documents         Document[]
  studyTasks        StudyTask[]
  studySessions     StudySession[]
  practiceQuestions PracticeQuestion[]
  practiceAttempts  PracticeAttempt[]
  notes             Note[]
  calendarEvents    CalendarEvent[]
  aiConversations   AIConversation[]
  topicWeightages   TopicWeightage[]
  subjectWeightages SubjectWeightage[]
}

enum ExamStatus {
  UPCOMING
  ONGOING
  COMPLETED
  ARCHIVED
}

model ExamStage {
  id          String   @id @default(cuid())
  examId      String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// SYLLABUS
// -----------------------------------------------------------------------------

model Subject {
  id          String   @id @default(cuid())
  examId      String
  name        String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exam              Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  topics            Topic[]
  studyTasks        StudyTask[]
  practiceQuestions PracticeQuestion[]
  notes             Note[]
  topicWeightages   TopicWeightage[]
  subjectWeightages SubjectWeightage[]
}

model Topic {
  id                    String      @id @default(cuid())
  subjectId             String
  parentTopicId         String?
  name                  String
  description           String?
  order                 Int         @default(0)
  difficulty            Difficulty  @default(MEDIUM)
  estimatedStudyMinutes Int?
  status                TopicStatus @default(NOT_STARTED)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentTopic       Topic?             @relation("NestedTopics", fields: [parentTopicId], references: [id])
  childTopics       Topic[]            @relation("NestedTopics")
  studyTasks        StudyTask[]
  practiceQuestions PracticeQuestion[]
  topicWeightages   TopicWeightage[]
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  REVISE
}

// -----------------------------------------------------------------------------
// DOCUMENTS & AI PREPARATION
// -----------------------------------------------------------------------------

model Document {
  id               String         @id @default(cuid())
  examId           String
  name             String
  originalFilename String
  mimeType         String
  fileSize         Int
  storageKey       String?
  status           DocumentStatus @default(UPLOADED)
  documentType     DocumentType   @default(OTHER)
  uploadedAt       DateTime       @default(now())
  processedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  exam      Exam               @relation(fields: [examId], references: [id], onDelete: Cascade)
  pages     DocumentPage[]
  chunks    DocumentChunk[]
  questions PracticeQuestion[]
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  PROCESSED
  FAILED
}

enum DocumentType {
  NOTIFICATION
  SYLLABUS
  PREVIOUS_PAPER
  STUDY_MATERIAL
  ANSWER_KEY
  ADMIT_CARD
  OTHER
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  pageNumber Int
  text       String?
  createdAt  DateTime @default(now())

  document Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  pageId     String?
  content    String
  chunkIndex Int
  metadata   Json?
  createdAt  DateTime @default(now())

  document Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page     DocumentPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// STUDY PLAN & SESSIONS
// -----------------------------------------------------------------------------

model StudyTask {
  id               String     @id @default(cuid())
  userId           String
  examId           String?
  subjectId        String?
  topicId          String?
  title            String
  description      String?
  scheduledDate    DateTime?
  estimatedMinutes Int?
  actualMinutes    Int        @default(0)
  status           TaskStatus @default(TODO)
  priority         Priority   @default(MEDIUM)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam          Exam?          @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject       Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  studySessions StudySession[]
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model StudySession {
  id              String        @id @default(cuid())
  userId          String
  examId          String?
  studyTaskId     String?
  startedAt       DateTime      @default(now())
  endedAt         DateTime?
  durationSeconds Int           @default(0)
  status          SessionStatus @default(ACTIVE)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam      Exam?      @relation(fields: [examId], references: [id], onDelete: SetNull)
  studyTask StudyTask? @relation(fields: [studyTaskId], references: [id], onDelete: SetNull)
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// -----------------------------------------------------------------------------
// PRACTICE ENGINE
// -----------------------------------------------------------------------------

model PracticeQuestion {
  id               String     @id @default(cuid())
  examId           String
  subjectId        String?
  topicId          String?
  question         String
  options          Json // Stores an array of options
  correctAnswer    String
  explanation      String?
  difficulty       Difficulty @default(MEDIUM)
  sourceDocumentId String?
  sourcePageNumber Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  exam           Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject        Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic          Topic?           @relation(fields: [topicId], references: [id], onDelete: SetNull)
  sourceDocument Document?        @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  answers        PracticeAnswer[]
}

model PracticeAttempt {
  id              String    @id @default(cuid())
  userId          String
  examId          String
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  totalQuestions  Int       @default(0)
  correctAnswers  Int       @default(0)
  wrongAnswers    Int       @default(0)
  skippedAnswers  Int       @default(0)
  score           Float     @default(0)
  accuracy        Float     @default(0)
  durationSeconds Int       @default(0)

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam             @relation(fields: [examId], references: [id], onDelete: Cascade)
  answers PracticeAnswer[]
}

model PracticeAnswer {
  id              String   @id @default(cuid())
  attemptId       String
  questionId      String
  selectedAnswer  String?
  isCorrect       Boolean  @default(false)
  markedForReview Boolean  @default(false)
  createdAt       DateTime @default(now())

  attempt  PracticeAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question PracticeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

// -----------------------------------------------------------------------------
// NOTES
// -----------------------------------------------------------------------------

model Note {
  id        String   @id @default(cuid())
  userId    String
  examId    String?
  subjectId String?
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam?    @relation(fields: [examId], references: [id], onDelete: SetNull)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
}

// -----------------------------------------------------------------------------
// CALENDAR
// -----------------------------------------------------------------------------

model CalendarEvent {
  id          String    @id @default(cuid())
  userId      String
  examId      String?
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  type        EventType @default(OTHER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam Exam? @relation(fields: [examId], references: [id], onDelete: SetNull)
}

enum EventType {
  EXAM
  STUDY
  PRACTICE
  REVISION
  DEADLINE
  OTHER
}

// -----------------------------------------------------------------------------
// AI INTEGRATION
// -----------------------------------------------------------------------------

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  examId    String?
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam     Exam?       @relation(fields: [examId], references: [id], onDelete: SetNull)
  messages AIMessage[]
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           Role
  content        String
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ASSISTANT
  SYSTEM
}

// -----------------------------------------------------------------------------
// TOPIC WEIGHTAGE
// -----------------------------------------------------------------------------

model TopicWeightage {
  id            String   @id @default(cuid())

  examId        String
  subjectId     String
  topicId       String
  userId        String

  sourceName    String?
  sourceYear    String?

  weightage           Float?
  questionCount       Int?
  marksCount          Float?
  estimatedDifficulty String?
  priorityRank        Int?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic         Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can have one weightage per topic per year/session
  @@unique([userId, examId, topicId, sourceYear])
}

model SubjectWeightage {
  id                  String   @id @default(cuid())

  examId              String
  subjectId           String
  userId              String

  sourceName          String?
  sourceYear          String?

  weightage           Float?
  questionCount       Int?
  marksCount          Float?
  estimatedDifficulty String?
  priorityRank        Int?
  studyRecommendation String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  exam                Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject             Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can have one weightage per subject per year/session
  @@unique([userId, examId, subjectId, sourceYear])
}

