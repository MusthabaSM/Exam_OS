{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Exam Prep OS",
  "version": "0.1.0",
  "identifier": "com.examprep.app",
  "build": {
    "frontendDist": "https://exam-prep-os.vercel.app",
    "devUrl": "https://exam-prep-os.vercel.app",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Exam Prep OS",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
